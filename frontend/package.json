    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "altcha": "^3.2.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
