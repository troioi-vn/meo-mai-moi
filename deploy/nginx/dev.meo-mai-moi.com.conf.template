server {
    server_name dev.meo-mai-moi.com;

    access_log /var/log/nginx/dev.meo-mai-moi.com_access.log;
    error_log /var/log/nginx/dev.meo-mai-moi.com_error.log error;

    client_max_body_size 10M;

    # Demo refresh window. The e2e runner creates /var/www/dev-maintenance/on
    # before wiping the demo and removes it afterwards. Checked per request, so
    # toggling needs no reload and no rewrite of this file — which matters,
    # because utils/dev-slot.sh rewrites this same file on every deploy.
    #
    # Loopback is exempt: the runner reaches the real application by connecting
    # to 127.0.0.1 with this hostname pinned, so it tests the app while visitors
    # see the notice. See docs/e2e-ci.md.
    set $maintenance "";
    if (-f /var/www/dev-maintenance/on) {
        set $maintenance "on";
    }
    if ($remote_addr = 127.0.0.1) {
        set $maintenance "";
    }
    if ($remote_addr = "::1") {
        set $maintenance "";
    }

    location = /maintenance.html {
        root /var/www/dev-maintenance;
        internal;
    }

    error_page 503 /maintenance.html;

    location ^~ /admin {
        return 404;
    }

    location ^~ /livewire {
        return 404;
    }

    location /app {
        proxy_pass http://127.0.0.1:__REVERB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        if ($maintenance = "on") {
            return 503;
        }

        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;

        proxy_connect_timeout 15s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    http2 on;
    ssl_certificate /etc/letsencrypt/live/dev.meo-mai-moi.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dev.meo-mai-moi.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = dev.meo-mai-moi.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name dev.meo-mai-moi.com;
    return 404; # managed by Certbot
}
