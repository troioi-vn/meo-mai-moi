    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "0.3.0",
